# Bright Data — required
# Get this from: https://brightdata.com/cp/setting (API Token section)
# Run `npx -p @brightdata/cli bdata login` to authenticate
BRIGHTDATA_API_KEY=your_api_key_here

# Collector IDs — filled in after running `bdata scraper create`
# Do NOT commit real values — only commit this example file
GH_RELEASES_COLLECTOR_ID=c_xxxxxxxxxxxx
VENDOR_CHANGELOG_COLLECTOR_ID=c_xxxxxxxxxxxx
NPM_RELEASES_COLLECTOR_ID=c_xxxxxxxxxxxx

# Alerting — optional (add the webhooks you want to use)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# LLM fallback classifier — optional
# Only needed if you want AI-assisted classification for unstructured changelogs
# ANTHROPIC_API_KEY=sk-ant-xxx
